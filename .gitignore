# Rust build artifacts. `hyperdb-compile-check` declares its own [workspace],
# so building it produces a second target/ that a root-anchored /target does
# not cover — hence the unanchored pattern as well.
/target
**/target/

# Local profiling / benchmarking scratch dirs
/target-prof
/bench_ab
/logs

# Editor / IDE
/.vscode

# Python bytecode cache (e.g. from .github/scripts)
__pycache__/
*.py[cod]

# hyperd binary downloaded via `make download-hyperd`
/.hyperd

# Test artifacts
test_results/
**/test_results/
*.hyper
hyperd*.log

# Node.js dependencies and build artifacts
node_modules/
*.node
dist/

# npm platform package binaries (built by CI or `make npm-pack`)
hyperdb-mcp/npm/*/hyperdb-mcp
hyperdb-mcp/npm/*/hyperdb-mcp.exe
hyperdb-mcp/npm/*/hyperd
hyperdb-mcp/npm/*/hyperd.exe
hyperdb-mcp/npm/**/*.tgz
hyperdb-api-node/npm/*/hyperd
hyperdb-api-node/npm/*/hyperd.exe
*.tgz

# OS cruft
.DS_Store
